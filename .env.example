# Copy to .env.local for local development (never commit real secrets).

# PostgreSQL connection string (ADR-0011, ADR-0012).
DATABASE_URL="postgres://garageflow:garageflow@localhost:5432/garageflow"

# Host port for the local docker compose Postgres (db:up / db:reset).
# Bump this if 5432 is taken by another local Postgres, then match the port in
# DATABASE_URL above. Docker Compose reads DB_PORT from `.env` (not `.env.local`),
# so set it there — or pass it inline, e.g. `DB_PORT=5433 npm run db:up`.
DB_PORT="5432"

# Better Auth (ADR-0014). Generate a strong secret for anything but local dev.
BETTER_AUTH_SECRET="dev-only-insecure-secret-change-me"
BETTER_AUTH_URL="http://localhost:3000"
